<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <PropertyGroup>
        <AssemblyName>ChatTwoVanilla</AssemblyName>
        <RootNamespace>ChatTwo</RootNamespace>
        <Version>1.43.11</Version>
        <AssemblyVersion>1.43.11.0</AssemblyVersion>
        <FileVersion>1.43.11.0</FileVersion>
        <RepoUrl>https://github.com/Requine-Moegi/ChatTwoVanilla</RepoUrl>
        <ImplicitUsings>enable</ImplicitUsings>
        <Authors>Infi, Anna</Authors>
        <Company>Infi, Anna</Company>
        <Product>Chat 2 Vanilla</Product>
        <Description>EUPL-1.2 fork of Chat 2 by Anna (ascclemens) and Infi (Infiziert90). Modified 2026-11-03 to add a toggleable vanilla chat-log style.</Description>
        <Copyright>Anna (ascclemens), Infi (Infiziert90), and contributors. Licensed under the EUPL-1.2.</Copyright>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MessagePack" Version="3.1.7" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
        <PackageReference Include="morelinq" Version="4.4.0" />
        <PackageReference Include="Pidgin" Version="3.3.0" />
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
        <PackageReference Include="Watson.Lite" Version="6.3.9" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Resources\Language.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Language.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Resources\Language.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Language.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="images\" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="SharedEmoteList.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

